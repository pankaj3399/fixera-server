MONGODB_URI=
PORT=
JWT_SECRET=
# Required only for `npm run seed:admin` / `npm run seed:prod`.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_PHONE=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
BREVO_API_KEY=
SMTP_SERVER=
SMTP_PORT=
SMTP_LOGIN=
FROM_EMAIL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=
FRONTEND_URL=http://localhost:3000
GOOGLE_MAPS_API_KEY=

# Vercel Cron — bearer token for /api/public/cron/* endpoints
# Vercel sends Authorization: Bearer <CRON_SECRET> on scheduled invocations.
# Generate a random string and set the same value in Vercel project env vars.
CRON_SECRET=

# Optional: discount code included in follow-up abandoned-checkout emails (2nd+ reminder).
# Only attached from the 2nd unfinished-checkout reminder onward.
MARKETING_ABANDONED_CHECKOUT_DISCOUNT_CODE=

# Optional comma-separated allowlist for monthly KPI PDF emails (cron/kpi-monthly-report).
# If empty, emails all admins with kpi.read permission.
KPI_REPORT_EMAILS=

# ---------------------------------------------------------------------------
# Marketing campaigns (Phase C — Brevo Marketing API)
# ---------------------------------------------------------------------------
# Optional: existing Brevo Contacts folder id for per-send lists.
# If unset, the API auto-creates/reuses a folder named "Fixtract Campaigns".
BREVO_MARKETING_FOLDER_ID=

# Optional sender display name on campaigns (FROM_EMAIL is still required and
# must be a verified Brevo sender on an authenticated domain).
BREVO_SENDER_NAME=Fixtract

# Maximum wait for Brevo's asynchronous contact-list import before a send fails
# safely and can be retried (default 60000, bounded to 5000-120000 ms).
BREVO_IMPORT_TIMEOUT_MS=60000

# Days without account/booking activity before a re-engagement autoSend campaign
# may target a subscriber (default 60 if omitted).
MARKETING_REENGAGEMENT_INACTIVE_DAYS=60

# Dry-run for admin "Send now" / scheduled / re-engagement campaign sends.
# - true  → no Brevo list/campaign/API send; Fixera still records a delivery
#           with recipientCount and marks the campaign sent (safe for local UI tests).
# - false / unset → real Brevo Marketing sends (counts toward plan quota;
#           free plan shares 300 emails/day with transactional mail).
# Also treated as dry-run when EMAIL_DEV_NO_SEND=true.
# Leave unset/false in production once domain auth + plan are ready.
MARKETING_CAMPAIGN_DRY_RUN=

# When true, transactional emails are logged but not sent via Brevo.
# EMAIL_DEV_NO_SEND=

# Firebase Admin SDK — required for FCM push notifications
# Base64-encode your service account JSON (portable across macOS/Linux):
#   base64 serviceAccount.json | tr -d '\n'
FCM_SERVICE_ACCOUNT_JSON=

# Firecrawl — required for backlink URL verification
# Get your key at https://firecrawl.dev
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Azure AI Translator — F0 free tier = 2M chars/month; leave unset to disable CMS auto-translation.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=

# Your Stripe Keys (TEST MODE)
STRIPE_SECRET_KEY=sk_test_51xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_51xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe Configuration
STRIPE_DEFAULT_CURRENCY=EUR
STRIPE_SUPPORTED_CURRENCIES=EUR,USD,GBP,CAD,AUD
STRIPE_PLATFORM_COMMISSION_PERCENT=0

# Peppol e-invoicing provider (Belgian B2B invoices)
# Only needed when Admin > Settings > E-invoicing provider is "odoo".
# With provider "manual" the UBL XML is generated and stored in S3 without dispatch.
# Accounting IDs and separate sales/self-billing purchase journals are discovered from Odoo.
# Supplier Peppol requires an active Purchase journal with Self Billing enabled.
ODOO_API_KEY=
ODOO_API_URL=https://qlab.odoo.com
# Optional: force a specific Odoo company when multiple exist (e.g. 2 for Fixtract)
# ODOO_COMPANY_ID=
# Opt-in integration test only. Must point to an Odoo Demo ID company named TEST ONLY.
# ODOO_PEPPOL_DEMO_COMPANY_ID=
# Optional: post invoices in Odoo immediately after sync
# ODOO_AUTO_POST=false

# ---------------------------------------------------------------------------
# Other runtime settings (all optional unless noted)
# ---------------------------------------------------------------------------
# OpenAI API key for AI project titles and FAQs in the project wizard; unset disables AI suggestions.
OPENAI_API_KEY=
# OpenAI model for project copy generation (default gpt-5.4-mini).
OPENAI_MODEL=gpt-5.4-mini
# Recipient of admin notification emails (completion and warranty escalations); defaults to FROM_EMAIL.
ADMIN_NOTIFICATIONS_EMAIL=
# Maximum JSON/urlencoded request body size accepted by Express (default 50mb).
REQUEST_BODY_LIMIT=50mb
# Minimum milliseconds between Stripe onboarding-link requests per professional (default 60000).
STRIPE_ONBOARDING_THROTTLE_MS=60000
# Timeout in ms for Brevo Marketing API requests (default 15000, bounded to 1000-120000; do not leave empty).
BREVO_REQUEST_TIMEOUT_MS=15000
# Timeout in ms for the support-meeting confirmation email send (default 20000).
SUPPORT_MEETING_EMAIL_TIMEOUT_MS=20000
# Debug only: "true" adds a debug payload to the public project team-availability response; keep false in production.
ENABLE_DEBUG_PAYLOAD=false
# Debug only: requests with header x-debug-payload equal to this secret get the debug payload; leave empty to disable.
DEBUG_PAYLOAD_SECRET=
# Debug only: "true" logs schedule-engine decisions; keep false in production.
ENABLE_SCHEDULE_DEBUG=false
# Legacy alias of MONGODB_URI (MONGODB_URI wins for the server; some scripts read MONGO_URI first).
# MONGO_URI=
# Set by the runtime/platform (development, production); do not set it here.
# NODE_ENV=

# Operator scripts only (set per invocation, never in the deployed environment):
# Target database for `src/scripts/migrate/marketingMigration.ts`.
# MIGRATION_MONGO_URI=
# "true" or "1" makes `src/scripts/maintenance/backfillProjectGeo.ts` report without writing.
# DRY_RUN=
# Delay in ms between geocoding calls in `backfillProjectGeo.ts` (default 200).
# GEOCODE_DELAY_MS=200
